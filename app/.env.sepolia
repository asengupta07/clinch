# Public Sepolia configuration (no secrets). Used by `npm run dev` / `npm run build` (the default); `npm run dev:local` uses anvil instead.
VITE_CHAIN_ID=11155111
VITE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
VITE_DEPLOYMENTS=src/deployments.sepolia.json
VITE_EXPLORER_URL=https://sepolia.etherscan.io
# Nox anon-client specifier on Sepolia, from https://ethereum.github.io/anon-rpc/adopters
VITE_ANON_RPC_SPECIFIER=0x35133267A8F7EC35046a83DCA0f4Ca8A6e1b7A9A
