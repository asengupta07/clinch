# All optional. Defaults target the local anvil chain and src/deployments.local.json.
# VITE_RPC_URL=http://127.0.0.1:8545
# VITE_CHAIN_ID=31337
# VITE_DEPLOYMENTS=src/deployments.sepolia.json
# VITE_EXPLORER_URL=https://sepolia.etherscan.io
# On-chain anon-client specifier (IWorkerSpecifier) for the Anon-RPC read path:
# VITE_ANON_RPC_SPECIFIER=0x...
# Keeper (npx tsx scripts/keeper.ts): KEEPER_PK=0x...  RPC_URL=...

# Optional WalletConnect / Reown project id (cloud.reown.com). Without it only browser-extension
# wallets (MetaMask, Rabby, Coinbase extension, any injected wallet) are offered in the connect modal.
# VITE_WALLETCONNECT_PROJECT_ID=
